    {
      "type": "state-timeline",
      "title": "Health status over time",
      "description": "ArgoCD Health status per Application (runtime state of the resources)",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max by (name) (argocd_app_info{health_status=\"Healthy\"}) * 0)\nor (max by (name) (argocd_app_info{health_status=\"Progressing\"}) * 1)\nor (max by (name) (argocd_app_info{health_status=\"Degraded\"}) * 2)\nor (max by (name) (argocd_app_info{health_status=~\"Missing|Unknown|Suspended\"}) * 3)",
          "legendFormat": "{{name}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Healthy",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Progressing",
                  "color": "blue",
                  "index": 1
                },
                "2": {
                  "text": "Degraded",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "Missing/Unknown",
                  "color": "text",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "center",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
