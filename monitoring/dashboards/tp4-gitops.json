    {
      "type": "timeseries",
      "title": "Sync operations (history)",
      "description": "argocd_app_sync_total: syncs per minute by app and result (Succeeded / Failed / Error)",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name, phase) (increase(argocd_app_sync_total[1m]))",
          "legendFormat": "{{name}} – {{phase}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "title": "Applications (current)",
      "description": "Snapshot of argocd_app_info labels",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "argocd_app_info",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Healthy": {
                        "color": "green",
                        "index": 0
                      },
                      "Progressing": {
                        "color": "blue",
                        "index": 1
                      },
                      "Degraded": {
                        "color": "red",
                        "index": 2
                      },
                      "Missing": {
                        "color": "gray",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sync"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Synced": {
                        "color": "green",
                        "index": 0
                      },
                      "OutOfSync": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "repo": true,
              "dest_server": true,
              "autosync_enabled": false,
              "operation": true
            },
            "indexByName": {
              "name": 0,
              "project": 1,
              "dest_namespace": 2,
              "sync_status": 3,
              "health_status": 4
            },
            "renameByName": {
              "name": "Application",
              "dest_namespace": "Namespace",
              "sync_status": "Sync",
              "health_status": "Health"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Git requests (repo-server)",
      "description": "argocd_git_request_total: ls-remote / fetch calls to Git (polling + refresh)",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
